{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "agent-skills@addy-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "skillOverrides": {
    "agent-skills:code-simplify": "off",
    "agent-skills:code-simplification": "off",
    "agent-skills:review": "off",
    "agent-skills:code-review-and-quality": "off",
    "agent-skills:plan": "user-invocable-only",
    "agent-skills:spec": "user-invocable-only",
    "agent-skills:test": "user-invocable-only",
    "agent-skills:a11y": "user-invocable-only",
    "agent-skills:webperf": "user-invocable-only",
    "agent-skills:ship": "user-invocable-only",
    "agent-skills:constraints": "user-invocable-only",
    "agent-skills:build": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}